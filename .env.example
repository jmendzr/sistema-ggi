# ────────────────────────────────────────────────────────────────
#  GGI Sistema — Plantilla de variables de entorno
#  Copiar como `.env` FUERA de public_html (config.php lo busca en ../../.env)
#  NUNCA versionar el .env real ni credenciales.
# ────────────────────────────────────────────────────────────────

# ── Aplicación ──
APP_URL=https://sistema.tu-dominio.com
APP_ENV=production            # production | development

# ── Base de datos ──
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

# ── Seguridad / cron / despliegue ──
CRON_TOKEN=                   # token para disparar crons por web (?token=...)
DEPLOY_SECRET=                # HMAC del webhook de GitHub (deploy.php)

# ── Web Push (VAPID) ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── WhatsApp (Meta Cloud API / Kapso) ──
WA_PROVIDER=meta              # meta | kapso
META_WA_VERSION=v21.0
META_WA_PHONE_NUMBER_ID=
META_WA_TOKEN=
META_WA_WABA_ID=
META_WA_REGISTER_PIN=
META_APP_SECRET=
META_APP_ID=
WA_WEBHOOK_VERIFY_TOKEN=
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=

# ── Meta Ads (conversiones + gasto) ──
META_DATASET_ID=
META_CAPI_ACCESS_TOKEN=
META_ADS_TOKEN=
META_AD_ACCOUNT_ID=

# ── Facturación Alegra / SUNAT ──
ALEGRA_EMAIL=
ALEGRA_TOKEN=
ALEGRA_STAMP=0                # 0 = borrador (prueba) · 1 = emisión real a SUNAT
ALEGRA_NC_STAMP=0             # notas de crédito: 0 borrador · 1 real
ALEGRA_DETRACCION_CUENTA=

# ── APIs Perú / couriers ──
SUNAT_API_TOKEN=
OLVA_TRACKING_API_KEY=

# ── Copiloto IA (opcional; sin llave → copiloto inactivo) ──
IA_PROVIDER=claude            # claude | openai | gemini | auto | "gemini,claude,openai"
IA_ANTHROPIC_KEY=
IA_ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
IA_OPENAI_KEY=
IA_OPENAI_MODEL=gpt-4o
IA_GEMINI_KEY=
IA_GEMINI_KEY_2=
IA_GEMINI_MODEL=gemini-flash-latest
